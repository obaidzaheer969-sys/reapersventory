{
  "expo": {
    "name": "ReapersVentory",
    "slug": "reapersventory-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-camera"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reapersventory.app"
    },
    "android": {
      "package": "com.reapersventory.app",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0a1628",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "appUrl": "https://reapersventory.com",
      "eas": {
        "projectId": "0d41dd09-46e8-44ef-a741-0e8c0132357b"
      }
    },
    "owner": "muhammadobaid"
  }
}
