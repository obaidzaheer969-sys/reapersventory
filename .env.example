APP_NAME=ReapersVentory
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: log (writes to storage/logs — does NOT send real email)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Hosting / production example (cPanel email or SMTP):
# MAIL_MAILER=smtp
# MAIL_HOST=mail.yourdomain.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=noreply@yourdomain.com
# MAIL_PASSWORD=your-email-password
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"
# APP_URL=https://yourdomain.com
#
# Alternate (port 587 / STARTTLS):
# MAIL_PORT=587
# MAIL_SCHEME=null
# Some hosts work with: MAIL_MAILER=sendmail
#
# Email verification / activation emails are disabled in the app.
# New users go straight to the dashboard after register.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MySQL (recommended for production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=reapersventory
# DB_USERNAME=root
# DB_PASSWORD=

# Private payment proofs disk uses FILESYSTEM_DISK=local by default
# FILESYSTEM_DISK=local

SUPER_ADMIN_NAME="ReapersVentory Admin"
SUPER_ADMIN_EMAIL=admin@reapersventory.test
SUPER_ADMIN_PASSWORD=ChangeMeNow!123


SUBSCRIPTION_GRACE_PERIOD_DAYS=7
SUBSCRIPTION_EXPIRING_SOON_DAYS=3
PAYMENT_PROOF_DISK=local
PAYMENT_PROOF_MAX_KB=5120

# Auto-deploy via https://reapersventory.com/deploy.php?secret=...
# Use a long random string. Leave empty to disable the endpoint.
DEPLOY_SECRET=

